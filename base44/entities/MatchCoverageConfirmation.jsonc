{
  "name": "MatchCoverageConfirmation",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "agent_name": {
      "type": "string"
    },
    "match_id": {
      "type": "string"
    },
    "match_label": {
      "type": "string"
    },
    "match_date": {
      "type": "string"
    },
    "match_time": {
      "type": "string"
    },
    "confirmed": {
      "type": "boolean",
      "description": "true = PO, false = JO"
    },
    "read_by_admin": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "agent_id",
    "match_id",
    "confirmed"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}