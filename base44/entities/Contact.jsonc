{
  "name": "Contact",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "reply": {
      "type": "string",
      "description": "Admin reply text"
    },
    "match_code": {
      "type": "string",
      "description": "Match code of agent sender"
    },
    "agent_username": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "type": {
      "type": "string",
      "enum": [
        "contact",
        "agent_application",
        "agent_message"
      ],
      "default": "contact"
    },
    "age": {
      "type": "number"
    },
    "city": {
      "type": "string"
    },
    "team_to_cover": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "name",
    "message"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}