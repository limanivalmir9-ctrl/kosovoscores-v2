{
  "name": "AgentDirectMessage",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "description": "ID of the agent"
    },
    "agent_name": {
      "type": "string"
    },
    "sender": {
      "type": "string",
      "enum": [
        "admin",
        "agent"
      ],
      "description": "Who sent the message"
    },
    "message": {
      "type": "string"
    },
    "read_by_agent": {
      "type": "boolean",
      "default": false
    },
    "read_by_admin": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": [
    "agent_id",
    "sender",
    "message"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}