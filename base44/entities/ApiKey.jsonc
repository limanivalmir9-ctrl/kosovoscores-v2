{
  "name": "ApiKey",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Emri i kompanis\u00eb / partnerit"
    },
    "key": {
      "type": "string",
      "description": "API key e gjeneruar (UUID)"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string",
      "description": "Sh\u00ebnime shtes\u00eb"
    },
    "last_used": {
      "type": "string",
      "description": "ISO timestamp i p\u00ebrdorimit t\u00eb fundit"
    },
    "usage_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}